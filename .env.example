# Sao thành `.env` rồi sửa. `make` đọc file này và truyền biến cho mọi lệnh con
# (python, uvicorn, pnpm); docker compose cũng tự đọc `.env`.
# Cú pháp KEY=value: không dấu nháy, không `$`, không `~`, không chú thích cuối dòng.
# Để trống là dùng mặc định. Không ghi secret vào đây (token Hugging Face đặt qua biến
# môi trường HF_TOKEN khi cần đẩy model).

# Gốc chứa data/, models/, outputs/, artifacts/<phiên bản>/, demo-data/ và khoá MPS (.mps.lock).
# Để trống: dùng thư mục repo. Khi repo nằm trong thư mục đồng bộ (Syncthing, Dropbox) hoặc
# nhiều git worktree dùng chung dữ liệu, đặt đường dẫn tuyệt đối ngoài repo,
# ví dụ /Users/ten/.cache/edupulse
EDUPULSE_HOME=

# Phiên bản bundle: thư mục artifacts/<phiên bản>/, cũng là tham số build image.
BUNDLE_VERSION=v1.1

# Ghi đè riêng từng đường dẫn; để trống là suy ra từ EDUPULSE_HOME hoặc thư mục repo.
# Bundle mà API nạp lúc chạy (một thư mục của một phiên bản).
EDUPULSE_ARTIFACTS_DIR=
EDUPULSE_DEMO_DIR=
EDUPULSE_VNCORENLP_DIR=
# Thư mục Next.js export tĩnh mà FastAPI phục vụ.
EDUPULSE_WEB_DIR=

# Số luồng ONNX Runtime.
EDUPULSE_ORT_THREADS=2
# 1 để bật nhận diện tên người bằng underthesea (tốn thêm RAM).
EDUPULSE_NER=0
# Các origin được gọi API từ trình duyệt, phân tách bằng dấu phẩy. Chỉ cần khi chạy `make web`
# (cổng 3000) cùng `make api` (cổng 8000): http://localhost:3000. Để trống khi triển khai.
EDUPULSE_CORS_ORIGINS=
# Thời gian giữ một batch khi tab đã đóng, tính bằng phút.
EDUPULSE_JOB_TTL_MIN=30

# Liên kết mã nguồn hiển thị trong ứng dụng (AGPL-3.0 §13). Đổi giá trị rồi khởi động lại,
# không cần build lại.
EDUPULSE_SOURCE_URL=https://github.com/your-user/edupulse

# Nguồn tải bundle cho `make fetch-artifacts` (scripts/fetch-artifacts.sh, chỉ cần curl): repo
# model công khai trên Hugging Face, dạng chủ/tên, và commit sha đầy đủ (40 ký tự) đã ghim.
# Người đẩy chạy `python -m ml.push_hub --upload` (cần HF_TOKEN hoặc `hf auth login`); lệnh in ra
# đúng hai dòng EDUPULSE_HF_REPO và EDUPULSE_HF_REVISION để chép vào đây. your-user là giá trị
# mẫu, script từ chối. Chưa có revision thì để trống và chép thẳng thư mục artifacts/<phiên bản>/.
EDUPULSE_HF_REPO=your-user/edupulse-phobert-mtl
EDUPULSE_HF_REVISION=

# Địa chỉ API mà `make web` gọi (chỉ dùng khi dev; bản export tĩnh gọi cùng origin).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Cổng máy chủ khi chạy docker compose (chỉ docker-compose.yml đọc)
EDUPULSE_PORT=8000

# Số từ tối đa của câu được giải thích (để trống = 25; chốt lại sau khi đo trên VPS)
EDUPULSE_XAI_MAX_WORDS=

# Liên kết tới model trên Hugging Face, hiện ở nút "Mô hình trên Hugging Face" (để trống: ẩn nút).
# `python -m ml.push_hub --upload` in sẵn giá trị này cùng hai dòng EDUPULSE_HF_* ở trên.
EDUPULSE_MODEL_URL=
